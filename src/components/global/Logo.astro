---
// Logo Winko (placeholder HTML/CSS, à remplacer par logo-winko-blue.svg officiel).
// L'onglet affiche le libellé du secteur (collection Secteurs).
import { url } from '../../lib/url';
interface Props { large?: boolean; link?: boolean; tab?: string; light?: boolean }
const { large = false, link = true, tab = 'Retail', light = false } = Astro.props;
const cls = ['logo', large && 'is-large', light && 'is-light'].filter(Boolean).join(' ');
---
{link ? (
  <a href={url('/')} class={cls} aria-label={`Winko ${tab}, accueil`}>
    <span class="logo_tab">{tab}</span>
    <span class="logo_wordmark">Winko</span>
  </a>
) : (
  <div class={cls}><span class="logo_tab">{tab}</span><span class="logo_wordmark">Winko</span></div>
)}
