---
// Popup « Télécharger l'app » · Figma 75:46
// Desktop uniquement : un QR code par store (iPhone → App Store, Android → Google Play).
// Sur mobile, le bouton mène directement au bon store (lien intelligent).
import Logo from './Logo.astro';
import { url } from '../../lib/url';
---
<!-- Popup « Télécharger l'app » · Figma 75:46 (desktop ; mobile : lien vers le store) -->
<div class="app-modal" id="telecharger" data-app-modal hidden>
  <div class="app-modal_overlay" data-app-modal-close></div>
  <div class="app-modal_dialog" role="dialog" aria-modal="true" aria-labelledby="app-modal-title">
    <button type="button" class="app-modal_close" aria-label="Fermer" data-app-modal-close>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 2l12 12M14 2L2 14"/></svg>
    </button>
    <Logo link={false} />
    <h2 class="heading-style-h2" id="app-modal-title">Votre prochaine mission est dans l’app.</h2>
    <p class="text-color-secondary">Scannez le QR code de votre téléphone avec son appareil photo pour télécharger Winko.</p>
    <div class="app-modal_qr-list">
      <figure class="app-modal_qr"><img class="app-modal_qr-image" src={url('/images/shared/qr-app-store.svg')} alt="QR code vers l’app Winko sur l’App Store" width="144" height="144"><figcaption class="app-modal_qr-label">iPhone</figcaption></figure>
      <figure class="app-modal_qr"><img class="app-modal_qr-image" src={url('/images/shared/qr-google-play.svg')} alt="QR code vers l’app Winko sur Google Play" width="144" height="144"><figcaption class="app-modal_qr-label">Android</figcaption></figure>
    </div>
  </div>
</div>
