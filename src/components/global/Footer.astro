---
// Footer · Figma 10:54 (Symbol Webflow « Footer »)
// Accroche et boutons selon la page (props du composant Webflow).
import Logo from './Logo.astro';
import CtaButton from './CtaButton.astro';
import { url } from '../../lib/url';
interface Props {
  tagline?: string;
  buttons?: ('app' | 'compte')[];
  current?: string;
}
const {
  tagline = 'Les professionnels de la vente pour chacun de vos besoins.',
  buttons = ['app', 'compte'],
  current,
} = Astro.props;
const nav = [
  { label: 'Accueil', href: '/' },
  { label: 'Professionnels', href: '/retail/professionnels' },
  { label: 'Entreprises', href: '/retail/entreprises' },
  { label: 'Contact', href: '/contact' },
];
const legal = [
  { label: 'Mentions légales', href: '/mentions-legales' },
  { label: 'Politique de confidentialité', href: '/confidentialite' },
  { label: 'Politique cookies', href: '/cookies' },
];
const cur = (l: string) => (l === current ? 'page' : undefined);
---
<!-- Footer · Figma 10:54 (Symbol Webflow « Footer ») · version panneau unique : logo intégré, barre légale en bas -->
<footer class="section_footer">
  <div class="padding-global">
    <div class="container-large">
      <div class="footer_component">
        <div class="footer_panel">
          <div class="footer_top">
            <div class="footer_signature">
              <Logo medium />
              <p class="footer_tagline">{tagline}</p>
              <div class="button-group">
                {buttons.map((b, i) => <CtaButton action={b} variant={i > 0 ? 'is-secondary is-small' : 'is-small'} />)}
              </div>
            </div>
            <div class="footer_qr" aria-hidden="true">
              <img src={url('/images/shared/qr-app.svg')} alt="" class="footer_qr-image" width="120" height="120" loading="lazy">
              <p class="footer_qr-caption">Scannez ce QR code avec l’appareil photo de votre téléphone pour télécharger Winko.</p>
            </div>
            <div class="footer_columns">
              <nav class="footer_column" aria-label="Pied de page">
                {nav.map((l) => <a href={url(l.href)} class="footer_link" aria-current={cur(l.label)}>{l.label}</a>)}
              </nav>
              <div class="footer_column">
                {legal.map((l) => <a href={url(l.href)} class="footer_link" aria-current={cur(l.label)}>{l.label}</a>)}
              </div>
            </div>
          </div>
          <div class="footer_bottom">
            <p class="footer_legal-text">© 2026 Winko. All rights reserved.</p>
            <div class="footer_bottom-end">
              <div class="footer_social">
                <a href="#" class="footer_social-link" aria-label="Winko sur LinkedIn"><svg width="22" height="22" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M216,26H40A14,14,0,0,0,26,40V216a14,14,0,0,0,14,14H216a14,14,0,0,0,14-14V40A14,14,0,0,0,216,26Zm2,190a2,2,0,0,1-2,2H40a2,2,0,0,1-2-2V40a2,2,0,0,1,2-2H216a2,2,0,0,1,2,2ZM94,112v64a6,6,0,0,1-12,0V112a6,6,0,0,1,12,0Zm88,28v36a6,6,0,0,1-12,0V140a22,22,0,0,0-44,0v36a6,6,0,0,1-12,0V112a6,6,0,0,1,12,0v2.11A34,34,0,0,1,182,140ZM98,84A10,10,0,1,1,88,74,10,10,0,0,1,98,84Z"/></svg></a>
                <a href="#" class="footer_social-link" aria-label="Winko sur Facebook"><svg width="22" height="22" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M128,26A102,102,0,1,0,230,128,102.12,102.12,0,0,0,128,26Zm6,191.8V150h26a6,6,0,0,0,0-12H134V112a18,18,0,0,1,18-18h16a6,6,0,0,0,0-12H152a30,30,0,0,0-30,30v26H96a6,6,0,0,0,0,12h26v67.8a90,90,0,1,1,12,0Z"/></svg></a>
                <a href="#" class="footer_social-link" aria-label="Winko sur Instagram"><svg width="22" height="22" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M128,82a46,46,0,1,0,46,46A46.06,46.06,0,0,0,128,82Zm0,80a34,34,0,1,1,34-34A34,34,0,0,1,128,162ZM176,26H80A54.06,54.06,0,0,0,26,80v96a54.06,54.06,0,0,0,54,54h96a54.06,54.06,0,0,0,54-54V80A54.06,54.06,0,0,0,176,26Zm42,150a42,42,0,0,1-42,42H80a42,42,0,0,1-42-42V80A42,42,0,0,1,80,38h96a42,42,0,0,1,42,42ZM190,76a10,10,0,1,1-10-10A10,10,0,0,1,190,76Z"/></svg></a>
              </div>
              <p class="footer_locale">FR · UK</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
