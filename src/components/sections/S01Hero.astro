---
// S01 · Hero photo · Figma 299:2625 (Accueil) / 506:2774 (variante visuel app, Professionnels)
// Propriété « Visuel » (attribut data-hero-visual, prop Webflow « Visuel : fond ou dessous ») :
//  - fond    : photo en panneau arrondi sur le fond accent, sous un voile neutre (Professionnels) ;
//  - dessous : visuel sous le texte, fond accent ;
//  - panneau : fond clair, panneau de signalisation 3D sous le texte, animé au scroll (Accueil).
//    Animation reprise de winko.io : séquence d'images (planche « sprite ») lue dans un canvas selon le scroll.
//    L'image sert d'affiche (1re image) ; la planche est donnée par la prop « Séquence » (attributs data-sequence-*).
// Les boutons passent par le slot (props « Lien » des boutons dans Webflow).
import { url } from '../../lib/url';
interface Props {
  tag: string;
  title: string; // HTML autorisé (<br>)
  text: string;
  image: { src: string; alt: string; width: number; height: number };
  variant?: 'photo' | 'app';
  visual?: 'fond' | 'dessous' | 'panneau';
  sequence?: { sprite: string; frames: number; cols: number };
}
const { tag, title, text, image, variant = 'photo', visual, sequence } = Astro.props;
const app = variant === 'app';
const mode = visual ?? (app ? 'dessous' : 'fond');
---
<!-- S01 · Hero photo · Figma 299:2625 (Accueil) / 506:2774 (variante visuel app, Professionnels) -->
<section class="section_hero background-color-accent" data-hero-visual={mode}>
  <div class="padding-global">
    <div class="container-large">
      <div class="hero_component">
        <div class="hero_content">
          <span class="tag is-on-color">{tag}</span>
          <h1 class:list={['heading-style-display-xl', { 'is-medium': app }, 'text-color-inverse max-width-large']} set:html={title} />
          <p class="text-size-large text-color-inverse max-width-medium">{text}</p>
          <div class="button-group is-center">
            <slot />
          </div>
        </div>
        <div class:list={['hero_image-wrapper', { 'is-contain': app }]}>
          <img src={url(image.src)} alt={image.alt} class="hero_image" width={image.width} height={image.height} fetchpriority="high"
            data-sequence-sprite={sequence ? url(sequence.sprite) : ''} data-sequence-frames={sequence?.frames ?? ''} data-sequence-cols={sequence?.cols ?? ''}>
        </div>
      </div>
    </div>
  </div>
</section>
