<!-- S18 · Étapes en cartes (3) · Figma 39:1453 (Professionnels) · étapes à valider par Djouher -->
<section class="section_steps">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-large">
        <div class="steps_component">
          <h2 class="heading-style-display-l text-align-center max-width-xlarge">Accédez à de nouvelles opportunités.</h2>
          <ol class="steps_list" role="list">
            <li class="steps_card is-photo">
              <img src={url('/images/professionnels/etape-compte.png')} alt="" class="steps_card-bg" width="291" height="435" loading="lazy">
              <span class="badge-arrow is-white">01</span>
              <div class="steps_content">
                <h3 class="heading-style-h3">Créez votre compte.</h3>
                <p class="text-color-secondary">La création de votre profil ne prend que 30 secondes.</p>
              </div>
            </li>
            <li class="steps_card">
              <span class="badge-arrow is-dark">02</span>
              <div class="steps_content">
                <h3 class="heading-style-h3">Valorisez vos compétences en 2 étapes.</h3>
                <p class="text-color-secondary">Notre questionnaire sur-mesure vous aide à rendre compte de vos talents pour chaque poste.</p>
              </div>
            </li>
            <li class="steps_card is-tint">
              <span class="badge-arrow">03</span>
              <img src={url('/images/shared/objet-signature.png')} alt="" class="steps_visual" width="893" height="810" loading="lazy">
              <div class="steps_content">
                <h3 class="heading-style-h3">Accédez à toutes les missions.</h3>
                <p class="text-color-secondary">Choisissez les missions qui vous correspondent vraiment. C’est vous qui avez la main.</p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>
