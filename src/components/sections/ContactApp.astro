---
// Contact · Écran 2B « Je cherche une mission » · renvoi vers l'app (version compacte)
// Desktop : tuile QR code (scan avec le téléphone). Mobile : bouton lien intelligent vers le store (CtaButton app).
// Remplace S09 (bandeau large + visuel app) sur cet écran. Textes : Figma 512:2576.
import CtaButton from '../global/CtaButton.astro';
import { url } from '../../lib/url';
interface Props { title?: string; text?: string }
const {
  title = 'Votre conseiller vous attend dans l’app.',
  text = 'Un accès direct à votre conseiller vous est réservé. Téléchargez l’app pour lui écrire.',
} = Astro.props;
---
<!-- Contact · Renvoi vers l'app (QR code desktop, bouton store mobile) -->
<section class="section_contact-app">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-small">
        <div class="contact-app_component">
          <div class="contact-app_content">
            <h2 class="heading-style-h2">{title}</h2>
            <p class="text-size-large">{text}</p>
            <div class="button-group contact-app_actions">
              <CtaButton action="app" variant="is-white" />
            </div>
          </div>
          <div class="contact-app_qr">
            <img src={url('/images/shared/qr-app.svg')} alt="QR code vers winko.io/app (lien provisoire)" class="contact-app_qr-image" width="160" height="160">
            <p class="contact-app_qr-caption">Scannez ce QR code avec l’appareil photo de votre téléphone pour télécharger Winko.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
