---
// S15 · Contenu légal · Figma 39:4073 · pas de CMS : une page Webflow par document et par langue
// Sommaire sticky + texte riche (Rich Text Webflow). Le contenu est passé en slot ; les titres h2 portent
// les ancres section-1, section-2… reprises dans le sommaire. Sans contenu : texte d'attente.
interface Props { sections: string[] }
const { sections } = Astro.props;
const placeholder = 'Contenu juridique en attente : fourni par Winko. Page statique, modifiable dans l’éditeur Webflow.';
const hasContent = Astro.slots.has('default');
---
<!-- S15 · Contenu légal · Figma 39:4073 · pas de CMS : une page Webflow par document et par langue -->
<section class="section_legal">
  <div class="padding-global">
    <div class="container-large">
      <div class="legal_component">
        <nav class="legal_toc" aria-label="Sommaire">
          <p class="legal_toc-title">Sommaire</p>
          {sections.map((s, i) => <a href={`#section-${i + 1}`}>{i + 1}. {s}</a>)}
        </nav>
        <div class="legal_rich-text">
          {hasContent ? <slot /> : sections.map((s, i) => (
            <Fragment>
              <h2 id={`section-${i + 1}`}>{i + 1}. {s}</h2>
              <p>{placeholder}</p>
            </Fragment>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
