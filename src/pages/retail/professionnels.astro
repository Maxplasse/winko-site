---
// Professionnels (B2C → app) · Figma 24:506
import BaseLayout from '../../layouts/BaseLayout.astro';
import S01Hero from '../../components/sections/S01Hero.astro';
import S26Logos from '../../components/sections/S26Logos.astro';
import S28Advantages from '../../components/sections/S28Advantages.astro';
import S18Steps from '../../components/sections/S18Steps.astro';
import S27Testimonials from '../../components/sections/S27Testimonials.astro';
import S20FaqGrid from '../../components/sections/S20FaqGrid.astro';
import S21CtaPhoto from '../../components/sections/S21CtaPhoto.astro';
import StickyWidget from '../../components/global/StickyWidget.astro';
import CtaButton from '../../components/global/CtaButton.astro';
import { faqFor } from '../../lib/content';
const faq = await faqFor('professionnels');
---
<BaseLayout
  title="Professionnels du retail · Votre prochaine mission en un clic | Winko"
  description="Les missions des enseignes que vous aimez. Choisissez vos créneaux, validez vos compétences, soyez payé en 72 h."
  active="Professionnels"
  headerAction="app"
  footer={{ tagline: 'Des missions retail selon votre expérience. D’un seul geste.', buttons: ['app'], current: 'Professionnels' }}
>
  <!-- S01 · Hero photo (variante visuel app) · Figma 506:2774 -->
  <S01Hero
    variant="app"
    tag="Professionnels"
    title="Votre prochaine mission<br>en un clic."
    text="Les missions des enseignes que vous aimez. Payées en 72 h."
    image={{ src: '/images/shared/visuel-app.png', alt: 'Aperçu de l’app Winko : liste des missions disponibles', width: 520, height: 327 }}
  >
    <CtaButton action="app" variant="is-white" />
  </S01Hero>

  <!-- S26 · Logos enseignes · Figma 297:3201 -->
  <S26Logos />

  <!-- S28 · Avantages en cards · Figma 506:531 -->
  <S28Advantages />

  <!-- S18 · Étapes en cartes (3) · Figma 39:1453 -->
  <S18Steps />

  <!-- S27 · Témoignages défilants · Figma 503:517 -->
  <S27Testimonials />

  <!-- S20 · FAQ en grille · Figma 39:1557 (cible : professionnels) -->
  <S20FaqGrid items={faq} />

  <!-- S21 · CTA final sur photo · Figma 39:1612 -->
  <S21CtaPhoto title="Révélez votre savoir-faire, ouvrez la voie à vos prochaines missions.">
    <CtaButton action="app" label="Téléchargez l’App" />
  </S21CtaPhoto>

  <!-- Widget sticky · Figma 24:751 (textes à valider : cf. Notes & décisions, points 1 et 2) -->
  <StickyWidget slot="after-main" title="Entretien personnalisé." text="Formulaire de contact à remplir en 2 min." label="Je postule" href="/contact" ariaLabel="Être recontacté" />
</BaseLayout>
